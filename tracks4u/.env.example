# Django
SECRET_KEY=REPLACE_WITH_RANDOM_50_CHARS
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost
# RDS PostgreSQL
DB_HOST=tracks4u-postgres-dev.c4qkjciamuny.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=tracks4u
DB_USER=tracks4u_app
DB_PASSWORD=REPLACE_WITH_APP_DB_PASSWORD
# Opcionales: solo si existe un usuario con más privilegios que tracks4u_app
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=
DB_SSLMODE=require
# Esquema SQL (en Docker se monta en /database)
SCHEMA_SQL_PATH=
# S3 (en EC2 usa IAM role y deja las keys vacías)
AWS_STORAGE_BUCKET_NAME=REPLACE_WITH_BUCKET
AWS_S3_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Telemetría
TELEMETRY_DRAIN_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS
TELEMETRY_SETTLE_SECONDS=5
TELEMETRY_RETENTION_DAYS=7
TELEMETRY_DRAIN_MAX_LIMIT=1000
# Notificaciones
NOTIFICATION_MODE=MOCK
